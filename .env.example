# Internal fork: prefer exporting these from the approved secrets manager over
# writing a .env. A .env is a long-lived credential in plaintext on disk, and the
# benchmarks read the environment first — a file is only the local-dev fallback.
# If you do copy this to .env, it is gitignored; promptfoo reads it automatically.

# Short-lived token from the secrets manager, not a personal long-lived key.
ANTHROPIC_API_KEY=sk-ant-...

# Route through the approved gateway rather than public egress. Unset, the
# benchmarks default to https://api.anthropic.com, which talks to the internet.
# ANTHROPIC_BASE_URL=https://<internal-claude-gateway>
